{
    "name": "dennisvanbeersel/symfony-logger-client",
    "description": "Symfony bundle for Application Logger error tracking platform",
    "type": "symfony-bundle",
    "homepage": "https://applogger.eu",
    "license": "MIT",
    "keywords": [
        "symfony",
        "error-tracking",
        "monitoring",
        "logging",
        "sentry"
    ],
    "authors": [
        {
            "name": "Dennis Van Beersel",
            "homepage": "https://applogger.eu"
        }
    ],
    "support": {
        "issues": "https://github.com/dennisvanbeersel/symfony-logger-client/issues",
        "source": "https://github.com/dennisvanbeersel/symfony-logger-client"
    },
    "require": {
        "php": ">=8.2",
        "applogger/sdk-core": "dev-master",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/monolog-bundle": "^3.0|^4.0",
        "symfony/http-client": "^6.4|^7.0|^8.0",
        "symfony/uid": "^6.4|^7.0|^8.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "symfony/phpunit-bridge": "^6.4|^7.0|^8.0",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "symfony/asset-mapper": "^6.4|^7.0|^8.0",
        "symfony/security-bundle": "^6.4|^7.0|^8.0",
        "symfony/twig-bundle": "^6.4|^7.0|^8.0",
        "twig/twig": "^3.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/yaml": "^6.4|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "ApplicationLogger\\Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ApplicationLogger\\Bundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "lint": [
            "@cs-check",
            "@phpstan"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
